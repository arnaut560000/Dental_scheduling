# Copy these values into your hosting provider's secret/environment-variable settings.
# Never commit a real .env file or real passwords to GitHub.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=replace-with-first-admin-username
ADMIN_PASSWORD=replace-with-a-long-unique-password
COOKIE_SECURE=1
DATABASE_URL=postgresql://database-user:database-password@database-host:5432/database-name
CLINIC_NAME=SmileCare
PRIVACY_CONTACT=clinic@example.com
# Public HTTPS address used in Facebook/Messenger/social link previews.
PUBLIC_URL=https://your-clinic-domain.example
# Omit locally to use the single-process memory limit. In production, use a hosted Redis URL.
# RATELIMIT_STORAGE_URI=rediss://username:password@redis-host:port/0
